# LLM Provider & Ollama API Endpoint
#LLM_PROFILE=ollama
#OLLAMA_BASE_URL=http://localhost:11434/v1
# Sent to Ollama verbatim, so it must match `ollama list` exactly.
#MODEL_VISION=gemma4:31b

# --- GWDG SAIA instead of Ollama ---
# To use SAIA (https://docs.hpc.gwdg.de/services/ai-services/saia/index.html)
# LLM_PROFILE=saia
# SAIA_API_KEY=your_saia_api_key_here
# MODEL_VISION=gemma-4-31b-it

# Mapillary Developer Token (from https://www.mapillary.com/dashboard/developers)
MAPILLARY_TOKEN=MLY|your_token_here

# HuggingFace Token for SAM3 weights (from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# --- PostGIS time series (optional) ---
# docker compose sets DATABASE_URL for the app container from these.
#POSTGRES_USER=trash
#POSTGRES_PASSWORD=change_me
#POSTGRES_DB=trash
#GRID_CELL_M=250
# Native Python runs: set this to enable storage; leave unset to disable.
#DATABASE_URL=postgresql://trash:change_me@localhost:5432/trash



