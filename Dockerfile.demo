# Roadside Trash Agent — offline demo container

FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code & fixtures
COPY app/ app/
COPY fixtures/ fixtures/

RUN mkdir -p runs

# Replay environment configuration
ENV REPLAY=1
ENV LLM_PROFILE=replay
ENV SAM3_REVISION=3c879f39826c281e95690f02c7821c4de09afae7
ENV PYTHONUNBUFFERED=1

EXPOSE 5006

CMD ["python", "-m", "app.main", "serve", "--host", "0.0.0.0", "--port", "5006"]
